--- !u!114 &364371347
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 364371336}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3840d988a9df8ba4cb68dff3db09c4ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  <MoodImage>k__BackingField: {fileID: 1809450015}
  <DialogueText>k__BackingField: {fileID: 1967412848}
  <NextButton>k__BackingField: {fileID: 26018829}
  <MumblingEmitter>k__BackingField: {fileID: 364371353}
  Dialogues:
  - <MoodImage>k__BackingField: {fileID: 21300000, guid: 08ce53860c895df44a41ffd0acb6b62a, type: 3}
    <Text>k__BackingField: Whoa-oh! Oh dear, oh dear. You startled me.. Who are you?
      You're... wait, you're not a giant butterfly in disguise, are you?
    <CharacterTime>k__BackingField: 0.02
    <AutoSkip>k__BackingField: 0
    <AutoSkipTime>k__BackingField: 0
    <Skippable>k__BackingField: 1
  - <MoodImage>k__BackingField: {fileID: 21300000, guid: ab543b9bb39c73f43aa9459459e1380a, type: 3}
    <Text>k__BackingField: ...
    <CharacterTime>k__BackingField: 0.5
    <AutoSkip>k__BackingField: 0
    <AutoSkipTime>k__BackingField: 0
    <Skippable>k__BackingField: 1
  - <MoodImage>k__BackingField: {fileID: 21300000, guid: e89ce46372a2c4d4e8ccc395f33ba0ad, type: 3}
    <Text>k__BackingField: Oh, right! My intern! I'd almost forgotten. Come in! Steplightly
      now-this is no ordinary garden... This is a special place for our winged companions!
    <CharacterTime>k__BackingField: 0.02
    <AutoSkip>k__BackingField: 0
    <AutoSkipTime>k__BackingField: 0
    <Skippable>k__BackingField: 1
  - <MoodImage>k__BackingField: {fileID: 21300000, guid: 08ce53860c895df44a41ffd0acb6b62a, type: 3}
    <Text>k__BackingField: Ah! Introductions, of course! Where are my manners? I
      am Professor Pup. E.Leon! Butterfly specialist, part-time gardener and friend
      to all that flutter! -player clicks- l've spent decades learning their ways,
      their favourite things, their little habits. You see, butterflies are quite
      picky tenants!
    <CharacterTime>k__BackingField: 0.02
    <AutoSkip>k__BackingField: 0
    <AutoSkipTime>k__BackingField: 0
    <Skippable>k__BackingField: 1
  - <MoodImage>k__BackingField: {fileID: 21300000, guid: 6aa1fe816baf78c4aa30024fe44b835b, type: 3}
    <Text>k__BackingField: 'This is why I have opened this place! A little safe haven
      for our winged friends! Dare I say, a rather charming social club. But keeping
      them here is quite a challenge. '
    <CharacterTime>k__BackingField: 0.02
    <AutoSkip>k__BackingField: 0
    <AutoSkipTime>k__BackingField: 0
    <Skippable>k__BackingField: 1
